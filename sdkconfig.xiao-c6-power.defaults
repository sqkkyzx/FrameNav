# Layered AFTER the XIAO compatibility defaults; separate opt-in build target.
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
CONFIG_BT_LE_SLEEP_ENABLE=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
# The XIAO has no fitted external 32.768 kHz crystal; use the main 40 MHz XTAL.
CONFIG_BT_LE_LP_CLK_SRC_MAIN_XTAL=y
# Keep USB Serial/JTAG and unsolicited 115200-baud GNSS RX continuously usable.
# BLE modem sleep is NOT CPU light sleep and does not disconnect the camera.
CONFIG_FREERTOS_USE_TICKLESS_IDLE=n
